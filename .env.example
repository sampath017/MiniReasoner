# Databricks workspace URL, for example https://adb-123456789.0.azuredatabricks.net
DATABRICKS_HOST=
# Personal access token for the workspace used to track training.
DATABRICKS_TOKEN=

# Azure Storage connection string for the account holding the MiniReasoner checkpoints.
AZURE_STORAGE_CONNECTION_STRING=

# Optional: base64-encoded rclone.conf (e.g. from base64 -w0 rclone.conf) to automatically configure Google Drive headless on new VMs without prompts
RCLONE_CONFIG_BASE64=
