# Optional Hugging Face access token for authenticated downloads.
HF_TOKEN=

# Optional download timeout in seconds for slow connections.
HF_HUB_DOWNLOAD_TIMEOUT=60

# Optional Google Drive viewer link to the prepared folder containing manifest.json.
MINIREASONER_CORPUS_DRIVE_URL=

# Optional persistent MLflow tracking server or SQLAlchemy database URI.
# The default on a VM is the project's runs/mlflow.db.
MLFLOW_TRACKING_URI=

# For JarvisLabs in a browser, use the HTTPS notebook address up to the end of the hostname.
# Example: https://YOUR_INSTANCE.notebooksn.jarvislabs.net
MINIREASONER_JARVIS_ORIGIN=

# Optional writable Drive checkpoint destination. VM default uses an authenticated rclone remote.
# Example: gdrive:MiniReasoner/checkpoints. A mounted Drive directory also works.
MINIREASONER_CHECKPOINT_ROOT=
